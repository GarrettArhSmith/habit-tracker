{
  "name": "habit-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "fallow:complexity": "npx fallow health --complexity",
    "fallow:file-health": "node scripts/fallow-file-health-gate.mjs",
    "fallow:strict": "node scripts/fallow-file-health-gate.mjs",
    "check:raw": "npm run lint && npm run typecheck && npm run test && npm run fallow:strict",
    "check": "node scripts/check-runner.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@supabase/supabase-js": "^2.57.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^2.1.8"
  }
}
